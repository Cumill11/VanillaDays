# Fonty się nie zmieniają, więc mogą siedzieć w cache na długo
/static/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

# Pliki z hashem w nazwie (Vite) — nowa wersja dostaje nową nazwę, więc cache na rok
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
