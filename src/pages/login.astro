---
import "@/styles/style.css";
import { env } from "cloudflare:workers";
import Field from "@/components/Field.astro";
import Icon from "@/components/Icon.astro";

if (Astro.locals.authenticated) return Astro.redirect("/", 303);

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const username = String(form.get("username") || "").trim();
  const password = String(form.get("password") || "");

  if (env.ADMIN_PASSWORD && username === env.ADMIN_USERNAME && password === env.ADMIN_PASSWORD) {
    Astro.session?.set("user", "admin");
    return Astro.redirect("/", 303);
  }
  error = "Nieprawidłowa nazwa użytkownika lub hasło.";
}
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Logowanie – VanillaDays</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/static/images/favicon.svg" />
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body class="login-page">
    <div class="login-card">
      <div class="login-brand">
        <img
          src="/static/images/logo.svg"
          alt="VanillaDays"
          class="login-logo"
          width="32"
          height="32"
        />
        VanillaDays
      </div>

      {
        error && (
          <div class="login-error">
            <Icon name="error" size={16} />
            {error}
          </div>
        )
      }

      <form method="post">
        <Field
          label="Nazwa użytkownika"
          type="text"
          id="username"
          name="username"
          autocomplete="username"
          required
          autofocus
        />
        <Field
          label="Hasło"
          type="password"
          id="password"
          name="password"
          autocomplete="current-password"
          required
        />
        <button type="submit" class="btn btn-filled login-submit">Zaloguj się</button>
      </form>
    </div>
  </body>
</html>
