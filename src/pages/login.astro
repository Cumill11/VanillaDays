---
import "@/styles/style.css";
import { env } from "cloudflare:workers";
import Field from "@/components/Field.astro";
import Icon from "@/components/Icon.astro";
import {
  createSession,
  isHttpsOnly,
  passwordMatches,
  safeNext,
  setSessionCookie,
} from "@/lib/auth";

if (Astro.locals.authenticated) return Astro.redirect("/", 303);

let error = "";
let nextUrl = safeNext(Astro.url.searchParams.get("next"));

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  nextUrl = safeNext(String(form.get("next") || ""));
  const username = String(form.get("username") || "").trim();
  const password = String(form.get("password") || "");
  const expectedUser = String(env.ADMIN_USERNAME || "").trim();
  const expectedPassword = String(env.ADMIN_PASSWORD || "");

  if (!expectedUser || !expectedPassword) {
    error = "Logowanie nie jest skonfigurowane.";
  } else if (
    passwordMatches(username, expectedUser) &&
    passwordMatches(password, expectedPassword)
  ) {
    const headers = new Headers({ Location: nextUrl });
    setSessionCookie(headers, await createSession(env.SECRET_KEY), isHttpsOnly(env.HTTPS_ONLY));
    return new Response(null, { status: 303, headers });
  } else {
    error = "Nieprawidłowa nazwa użytkownika lub hasło.";
  }
}
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Logowanie – VanillaDays</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/static/images/logo.svg" />
  </head>
  <body class="login-page">
    <div class="login-card">
      <div class="login-brand">
        <img
          src="/static/images/logo.svg"
          alt="VanillaDays"
          class="login-logo"
          width="32"
          height="32"
        />
        VanillaDays
      </div>

      {
        error && (
          <div class="login-error">
            <Icon name="error" size={16} />
            {error}
          </div>
        )
      }

      <form method="post">
        <input type="hidden" name="next" value={nextUrl} />
        <Field
          label="Nazwa użytkownika"
          type="text"
          id="username"
          name="username"
          autocomplete="username"
          required
          autofocus
        />
        <Field
          label="Hasło"
          type="password"
          id="password"
          name="password"
          autocomplete="current-password"
          required
        />
        <button type="submit" class="btn btn-filled login-submit">Zaloguj się</button>
      </form>
    </div>
  </body>
</html>
