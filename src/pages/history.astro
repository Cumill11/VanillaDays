---
import { actions } from "astro:actions";
import { env } from "cloudflare:workers";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Chip from "@/components/Chip.astro";
import EntryTypeChip from "@/components/EntryTypeChip.astro";
import Icon from "@/components/Icon.astro";
import { getHistoryEntries, getHistoryOvertime } from "@/lib/db";
import {
  fmtDatePl,
  fmtDays,
  fmtHours,
  MONTH_NAMES,
  parseOptionalMonth,
  parseYear,
  yearContext,
} from "@/lib/dates";
import { LEAVE_TYPES } from "@/lib/leaveTypes";

const deleted =
  Astro.getActionResult(actions.deleteEntry) ?? Astro.getActionResult(actions.deleteOvertime);
if (deleted && !deleted.error) {
  return Astro.redirect(Astro.request.headers.get("referer") || "/history", 303);
}

const year = parseYear(Astro.url.searchParams.get("year"));
const ctx = yearContext(year);
const typeFilter = Astro.url.searchParams.get("type") || "";
const monthNum = parseOptionalMonth(Astro.url.searchParams.get("month"));
const monthFilter = monthNum ? String(monthNum) : "";

const [entries, otEntries] = await Promise.all([
  getHistoryEntries(env.DB, year, typeFilter, monthNum),
  getHistoryOvertime(env.DB, year, monthNum),
]);
const otEarned = otEntries
  .filter((entry) => entry.type !== "taken")
  .reduce((sum, entry) => sum + Number(entry.hours), 0);
const otTaken = otEntries
  .filter((entry) => entry.type === "taken")
  .reduce((sum, entry) => sum + Number(entry.hours), 0);
const otBalance = otEarned - otTaken;
const vacDays = entries.filter((entry) => entry.type === "vacation").length;
const hoCount = entries.filter((entry) => entry.type === "home_office").length;
---

<BaseLayout
  title={`Historia – ${year}`}
  pageTitle="Historia wpisów"
  active="history"
  year={year}
  yearOptions={ctx.yearOptions}
  today={ctx.today}
>
  <div class="print-header">
    <h2>Urlopy i nieobecności &mdash; {year}</h2>
  </div>

  <div class="card filter-bar">
    <form method="get" action="/history" class="filter-form">
      <input type="hidden" name="year" value={year} />

      <select
        name="type"
        class="field-input field-input--sm"
        data-auto-submit
        aria-label="Typ wpisu"
      >
        <option value="">Wszystkie typy</option>
        {
          LEAVE_TYPES.map(({ type, fullLabel }) => (
            <option value={type} selected={typeFilter === type}>
              {fullLabel}
            </option>
          ))
        }
      </select>

      <select
        name="month"
        class="field-input field-input--sm"
        data-auto-submit
        aria-label="Miesiąc"
      >
        <option value="">Wszystkie miesiące</option>
        {
          MONTH_NAMES.map((name, index) => (
            <option value={index + 1} selected={monthFilter === String(index + 1)}>
              {name}
            </option>
          ))
        }
      </select>

      {
        (typeFilter || monthFilter) && (
          <a href={`/history?year=${year}`} class="btn btn-text btn-sm">
            <Icon name="close" size={16} /> Wyczyść
          </a>
        )
      }

      <div class="export-btns">
        <a
          href={`/export/csv?year=${year}&type=${encodeURIComponent(typeFilter)}&month=${monthFilter}`}
          class="btn btn-text btn-sm"
          title="Pobierz CSV"
        >
          <Icon name="download" size={16} /> CSV
        </a>
        <button type="button" data-print class="btn btn-text btn-sm" title="Drukuj / Zapisz PDF">
          <Icon name="print" size={16} /> Drukuj
        </button>
      </div>

      <div class="filter-summary">
        {
          vacDays > 0 && (
            <Chip class="chip--vacation" icon="beach_access">
              {fmtDays(vacDays)} urlopu
            </Chip>
          )
        }
        {
          hoCount > 0 && (
            <Chip class="chip--ho" icon="home">
              {hoCount} dni HO
            </Chip>
          )
        }
      </div>
    </form>
  </div>

  {
    entries.length > 0 ? (
      <div class="card table-card">
        <table class="data-table">
          <thead>
            <tr>
              <th>Data</th>
              <th>Typ</th>
              <th class="hide-mobile">Notatka</th>
              <th class="table-actions">Akcje</th>
            </tr>
          </thead>
          <tbody>
            {entries.map((entry) => (
              <tr>
                <td>
                  <span class="entry-date-bold">{fmtDatePl(entry.date)}</span>
                </td>
                <td>
                  <EntryTypeChip type={entry.type} />
                </td>
                <td class="hide-mobile">
                  <span class="table-notes">{entry.notes || "—"}</span>
                </td>
                <td class="table-actions">
                  <button
                    type="button"
                    class="icon-btn icon-btn--edit"
                    data-edit-entry={JSON.stringify(entry)}
                    title="Edytuj"
                  >
                    <Icon name="edit" />
                  </button>
                  <form
                    method="post"
                    action={actions.deleteEntry}
                    class="chip-form"
                    data-confirm={`Usunąć wpis z dnia ${fmtDatePl(entry.date)}?`}
                  >
                    <input type="hidden" name="id" value={entry.id} />
                    <button type="submit" class="icon-btn icon-btn--delete" title="Usuń">
                      <Icon name="delete" />
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="empty-state">
        <Icon name="event_busy" class="empty-state-icon" size={32} />
        <p>Brak wpisów dla wybranych filtrów.</p>
      </div>
    )
  }

  {
    otEntries.length > 0 && (
      <div class="card table-card overtime-history-card">
        <div class="table-section-header">
          <span class="card-title card-title--inline">Nadgodziny</span>
          <div class="chip-row">
            {otEarned > 0 && (
              <Chip class="chip--ot" icon="more_time">
                +{fmtHours(otEarned)}h zarobione
              </Chip>
            )}
            {otTaken > 0 && (
              <Chip class="chip--ot-taken" icon="schedule">
                -{fmtHours(otTaken)}h odebrane
              </Chip>
            )}
            <Chip class={otBalance >= 0 ? "chip--ot" : "chip--bezp"}>
              Saldo: {fmtHours(otBalance)}h
            </Chip>
          </div>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Data</th>
              <th>Typ</th>
              <th>Godziny</th>
              <th class="hide-mobile">Notatka</th>
              <th class="table-actions">Akcje</th>
            </tr>
          </thead>
          <tbody>
            {otEntries.map((entry) => (
              <tr>
                <td>
                  <span class="entry-date-bold">{fmtDatePl(entry.date)}</span>
                </td>
                <td>
                  {entry.type === "taken" ? (
                    <Chip class="chip--ot-taken" icon="schedule">
                      Odebrane
                    </Chip>
                  ) : (
                    <Chip class="chip--ot" icon="more_time">
                      Zarobione
                    </Chip>
                  )}
                </td>
                <td>
                  <Chip class={entry.type === "taken" ? "chip--ot-taken" : "chip--ot"}>
                    {entry.type === "taken"
                      ? `-${fmtHours(entry.hours)}`
                      : `+${fmtHours(entry.hours)}`}
                    h
                  </Chip>
                </td>
                <td class="hide-mobile">
                  <span class="table-notes">{entry.notes || "—"}</span>
                </td>
                <td class="table-actions">
                  <form
                    method="post"
                    action={actions.deleteOvertime}
                    class="chip-form"
                    data-confirm={`Usunąć wpis nadgodzin z dnia ${fmtDatePl(entry.date)}?`}
                  >
                    <input type="hidden" name="id" value={entry.id} />
                    <button type="submit" class="icon-btn icon-btn--delete" title="Usuń">
                      <Icon name="delete" />
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</BaseLayout>
