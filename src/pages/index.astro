---
import { actions } from "astro:actions";
import { env } from "cloudflare:workers";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Chip from "@/components/Chip.astro";
import Field from "@/components/Field.astro";
import Icon from "@/components/Icon.astro";
import { getBalance, getRecentEntries, getStats, getWarnings } from "@/lib/db";
import { fmtDatePl, fmtDays, parseYear, yearContext } from "@/lib/dates";
import { getLeaveTypeMeta } from "@/lib/leaveTypes";

const otResult = Astro.getActionResult(actions.saveOvertime);
if (otResult && !otResult.error) {
  return Astro.redirect(Astro.request.headers.get("referer") || "/", 303);
}

const year = parseYear(Astro.url.searchParams.get("year"));
const ctx = yearContext(year);
const balance = await getBalance(env.DB, year);
const stats = await getStats(env.DB, year);
const recent = await getRecentEntries(env.DB, year);
const warnings = getWarnings(year, balance);
if (otResult?.error) {
  warnings.unshift(["error", "Nie udało się zapisać nadgodzin", otResult.error.message]);
}

const chartMax = Math.max(1, ...stats.map((m) => Math.max(m.vacation, m.home_office)));
const hasChartData = stats.some((m) => m.vacation || m.home_office);
const barHeight = (value: number) => `height:${Math.round((value / chartMax) * 100)}%`;
---

<BaseLayout
  title={`Pulpit – ${year}`}
  pageTitle={`Podsumowanie ${year}`}
  active="dashboard"
  year={year}
  yearOptions={ctx.yearOptions}
  today={ctx.today}
>
  {
    warnings.length > 0 && (
      <div class="warnings-list">
        {warnings.map(([lvl, title, msg]) => (
          <div class={`warning-item warning-item--${lvl}`}>
            <Icon name={lvl === "error" ? "error" : lvl === "warning" ? "warning" : "info"} />
            <div>
              <strong>{title}</strong>
              <span>{msg}</span>
            </div>
          </div>
        ))}
      </div>
    )
  }

  <div class="cards-row">
    <div class="balance-card balance-card--vacation">
      <div class="bc-header">
        <span class="bc-label">URLOP</span>
        <Icon name="beach_access" class="bc-icon" size={32} />
      </div>
      <div
        class:list={[
          "bc-remaining",
          {
            "bc-remaining--critical": balance.vacation.remaining <= 1,
            "bc-remaining--low": balance.vacation.remaining > 1 && balance.vacation.remaining <= 3,
          },
        ]}
      >
        {fmtDays(balance.vacation.remaining)}
      </div>
      <div class="bc-sub">pozostało</div>
      <div class="progress-bar">
        <div class="progress-fill progress-fill--vacation" style={`width:${balance.vacation.pct}%`}>
        </div>
      </div>
      <div class="bc-footer">
        <span>{fmtDays(balance.vacation.used)} z {fmtDays(balance.vacation.total)}</span>
        {
          balance.vacation.carried_over > 0 && (
            <Chip class="chip--vacation" icon="move_down" iconSize={12}>
              +{fmtDays(balance.vacation.carried_over)} przeniesione
            </Chip>
          )
        }
      </div>
    </div>

    <div class="balance-card balance-card--overtime" data-overtime-card>
      <div class="bc-header">
        <span class="bc-label">NADGODZINY</span>
        <Icon name="more_time" class="bc-icon" size={32} />
      </div>
      <div
        class:list={[
          "bc-remaining",
          {
            "bc-remaining--critical": balance.overtime_balance < 0,
            "bc-remaining--low": balance.overtime_balance >= 0 && balance.overtime_balance <= 4,
          },
        ]}
      >
        {Math.trunc(balance.overtime_balance)}h
      </div>
      <div class="bc-sub">saldo nadgodzin</div>
      <div class="bc-footer bc-footer--compact">
        <button type="button" class="chip chip--ot" data-overtime-mode="earned">
          <Icon name="add" size={12} />
          Zarobiłem
        </button>
        <button type="button" class="chip chip--ot-taken" data-overtime-mode="taken">
          <Icon name="remove" size={12} />
          Odebrałem
        </button>
      </div>
      <div class="overtime-form-wrap" data-overtime-form-wrap hidden>
        <form method="post" action={actions.saveOvertime}>
          <input type="hidden" name="type" data-overtime-type />
          <div class="overtime-form-row">
            <Field
              label="Data"
              type="date"
              id="ot-date"
              name="date"
              data-today=""
              required
              class="overtime-field overtime-field--date"
              labelClass="field-label--compact"
              inputClass="field-input--sm"
            />
            <Field
              label="Godziny"
              type="number"
              id="ot-hours"
              name="hours"
              step="0.5"
              min="0.5"
              placeholder="np. 4"
              required
              class="overtime-field overtime-field--hours"
              labelClass="field-label--compact"
              inputClass="field-input--sm"
            />
            <Field
              label="Notatka"
              type="text"
              id="ot-notes"
              name="notes"
              placeholder="opcjonalnie"
              class="overtime-field overtime-field--notes"
              labelClass="field-label--compact"
              inputClass="field-input--sm"
            />
            <button type="submit" class="btn btn-filled btn-sm overtime-submit">Zapisz</button>
          </div>
        </form>
      </div>
    </div>

    <div class="balance-card balance-card--ho">
      <div class="bc-header">
        <span class="bc-label">HOME OFFICE</span>
        <Icon name="home" class="bc-icon" size={32} />
      </div>
      <div
        class:list={[
          "bc-remaining",
          {
            "bc-remaining--critical": balance.home_office.remaining <= 1,
            "bc-remaining--low":
              balance.home_office.remaining > 1 && balance.home_office.remaining <= 3,
          },
        ]}
      >
        {balance.home_office.remaining}
      </div>
      <div class="bc-sub">dni pozostało</div>
      <div class="progress-bar">
        <div class="progress-fill progress-fill--ho" style={`width:${balance.home_office.pct}%`}>
        </div>
      </div>
      <div class="bc-footer">
        <span>{balance.home_office.used} z {balance.home_office.limit} dni</span>
      </div>
    </div>
  </div>

  <div class="card other-leaves-card">
    <div class="card-title">Pozostałe nieobecności {year}</div>
    <div class="other-leaves-grid">
      <div class="ol-item">
        <div class="ol-icon ol-icon--okol"><Icon name="celebration" /></div>
        <div class="ol-body">
          <span class="ol-label">Urlop okolicznościowy</span>
          <span class="ol-sub">max {balance.okolicznosciowy.limit} dni/rok</span>
        </div>
        <div class="ol-count">
          <span class="ol-used ol-used--okol">{balance.okolicznosciowy.used}</span>
          <span class="ol-limit">/ {balance.okolicznosciowy.limit}</span>
        </div>
        <div class="ol-progress">
          <div class="progress-bar progress-bar--full">
            <div
              class="progress-fill progress-fill--okol"
              style={`width:${balance.okolicznosciowy.pct}%`}
            >
            </div>
          </div>
          {
            balance.okolicznosciowy.remaining === 0 && (
              <span class="ol-badge ol-badge--warn">Limit wyczerpany</span>
            )
          }
        </div>
      </div>
      <div class="ol-item">
        <div class="ol-icon ol-icon--bezp"><Icon name="money_off" /></div>
        <div class="ol-body">
          <span class="ol-label">Urlop bezpłatny</span>
          <span class="ol-sub">bez limitu</span>
        </div>
        <div class="ol-count">
          <span class="ol-used ol-used--bezp">{balance.bezplatny.used}</span>
          <span class="ol-limit">dni</span>
        </div>
        <div class="ol-progress"></div>
      </div>
      <div class="ol-item">
        <div class="ol-icon ol-icon--l4"><Icon name="medical_services" /></div>
        <div class="ol-body">
          <span class="ol-label">L4 / Zwolnienie lekarskie</span>
          <span class="ol-sub">nie wlicza się do urlopu</span>
        </div>
        <div class="ol-count">
          <span class="ol-used ol-used--l4">{balance.l4.used}</span>
          <span class="ol-limit">dni</span>
        </div>
        <div class="ol-progress"></div>
      </div>
      <div class="ol-item">
        <div class="ol-icon ol-icon--za"><Icon name="event_repeat" /></div>
        <div class="ol-body">
          <span class="ol-label">Urlop za święto</span>
          <span class="ol-sub">nie wlicza się do urlopu</span>
        </div>
        <div class="ol-count">
          <span class="ol-used ol-used--za">{balance.za_swieto.used}</span>
          <span class="ol-limit">dni</span>
        </div>
        <div class="ol-progress"></div>
      </div>
    </div>
  </div>

  <div class="card chart-card">
    <div class="card-title">Rozkład miesięczny</div>
    {
      hasChartData ? (
        <div class="chart">
          <ul class="chart-bars">
            {stats.map((month) => (
              <li class="chart-col">
                <div class="chart-stack">
                  <div
                    class="chart-bar chart-bar--vacation"
                    style={barHeight(month.vacation)}
                    title={`${month.label}: ${month.vacation} dni urlopu`}
                  />
                  <div
                    class="chart-bar chart-bar--ho"
                    style={barHeight(month.home_office)}
                    title={`${month.label}: ${month.home_office} dni HO`}
                  />
                </div>
                <span class="chart-label">{month.label}</span>
              </li>
            ))}
          </ul>
          <div class="chart-legend">
            <span class="legend-item">
              <span class="legend-dot legend-dot--vacation" />
              Urlop
            </span>
            <span class="legend-item">
              <span class="legend-dot legend-dot--ho" />
              Home Office
            </span>
          </div>
        </div>
      ) : (
        <p class="chart-empty">Brak wpisów w tym roku.</p>
      )
    }
  </div>

  {
    recent.length > 0 && (
      <div class="card">
        <div class="card-title">Ostatnie wpisy</div>
        <div class="entry-list">
          {recent.map((entry) => (
            <div class="entry-row">
              <span class={`entry-dot entry-dot--${entry.type}`} />
              <div class="entry-info">
                <span class="entry-date">{fmtDatePl(entry.date)}</span>
                {entry.notes && <span class="entry-notes">{entry.notes}</span>}
              </div>
              <div class="entry-days">
                <span class={`entry-days-val entry-days-val--${entry.type}`}>
                  {getLeaveTypeMeta(entry.type).shortLabel}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    )
  }
</BaseLayout>
