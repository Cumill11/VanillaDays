---
import { actions } from "astro:actions";
import { env } from "cloudflare:workers";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CalendarLeaveChip from "@/components/CalendarLeaveChip.astro";
import Icon from "@/components/Icon.astro";
import { getEntriesBetween, getOvertimeBetween } from "@/lib/db";
import {
  getCalendarDays,
  getPolishHolidays,
  isoDate,
  MONTH_NAMES,
  parseMonth,
  parseYear,
  yearContext,
} from "@/lib/dates";
import type { LeaveEntry, OvertimeEntry } from "@/lib/types";

const deleted =
  Astro.getActionResult(actions.deleteEntry) ?? Astro.getActionResult(actions.deleteOvertime);
if (deleted && !deleted.error) {
  return Astro.redirect(Astro.request.headers.get("referer") || "/calendar", 303);
}

const year = parseYear(Astro.url.searchParams.get("year"));
const month = parseMonth(Astro.url.searchParams.get("month"));
const ctx = yearContext(year);
const days = getCalendarDays(year, month);
const start = isoDate(days[0]);
const end = isoDate(days[days.length - 1]);
const entries = await getEntriesBetween(env.DB, start, end);
const overtime = await getOvertimeBetween(env.DB, start, end);
const holidays = getPolishHolidays(year);

const entriesByDate = new Map<string, LeaveEntry[]>();
const overtimeByDate = new Map<string, OvertimeEntry[]>();
for (const entry of entries) {
  const key = entry.date.substring(0, 10);
  entriesByDate.set(key, [...(entriesByDate.get(key) || []), entry]);
}
for (const entry of overtime) {
  const key = entry.date.substring(0, 10);
  overtimeByDate.set(key, [...(overtimeByDate.get(key) || []), entry]);
}

const prevMonth = month > 1 ? month - 1 : 12;
const prevYear = month > 1 ? year : year - 1;
const nextMonth = month < 12 ? month + 1 : 1;
const nextYear = month < 12 ? year : year + 1;

const LEAVE_ORDER = ["vacation", "home_office", "okolicznosciowy", "bezplatny", "l4", "za_swieto"];
const DAY_TINT: Record<string, string> = {
  vacation: "vacation",
  home_office: "ho",
  okolicznosciowy: "okol",
  bezplatny: "bezp",
  l4: "l4",
  za_swieto: "za_swieto",
};
const fmtHours = (value: number) =>
  Number.isInteger(Number(value)) ? String(Math.trunc(Number(value))) : String(Number(value));

const legendTypes = [
  { cls: "vacation", icon: "beach_access", label: "Urlop" },
  { cls: "ho", icon: "home", label: "Home Office" },
  { cls: "okol", icon: "celebration", label: "Okolicznościowy" },
  { cls: "bezp", icon: "money_off", label: "Bezpłatny" },
  { cls: "l4", icon: "medical_services", label: "L4" },
  { cls: "za_swieto", icon: "event_repeat", label: "Za święto" },
  { cls: "ot-earned", icon: "more_time", label: "Nadgodziny (+)" },
  { cls: "ot-taken", icon: "schedule", label: "Odbiór godzin (−)" },
] as const;
---

<BaseLayout
  title={`Kalendarz – ${MONTH_NAMES[month - 1]} ${year}`}
  pageTitle="Kalendarz"
  active="calendar"
  year={year}
  yearOptions={ctx.yearOptions}
  today={ctx.today}
>
  <div class="card cal-card">
    <div class="cal-nav">
      <a
        href={`/calendar?year=${prevYear}&month=${prevMonth}`}
        class="icon-btn"
        aria-label="Poprzedni miesiąc"
      >
        <Icon name="chevron_left" />
      </a>
      <h2 class="cal-month-title">{MONTH_NAMES[month - 1]} {year}</h2>
      <a
        href={`/calendar?year=${nextYear}&month=${nextMonth}`}
        class="icon-btn"
        aria-label="Następny miesiąc"
      >
        <Icon name="chevron_right" />
      </a>
      <a
        href={`/calendar?year=${ctx.today.getFullYear()}&month=${ctx.today.getMonth() + 1}`}
        class="icon-btn"
        title="Dzisiaj"
        aria-label="Dzisiaj"
      >
        <Icon name="today" />
      </a>
    </div>

    <div class="cal-grid">
      {
        ["Pon", "Wt", "Śr", "Czw", "Pt", "Sob", "Nie"].map((label, index) => (
          <div class:list={["cal-weekday", { "cal-weekday--weekend": index > 4 }]}>{label}</div>
        ))
      }

      {
        days.map((day) => {
          const dateStr = isoDate(day);
          const dayEntries = entriesByDate.get(dateStr) || [];
          const otDay = overtimeByDate.get(dateStr) || [];
          const inMonth = day.getMonth() + 1 === month;
          const isWeekend = day.getDay() === 0 || day.getDay() === 6;
          const isHoliday = dateStr in holidays;
          const canAdd = inMonth && !isWeekend && dayEntries.length === 0;
          const firstOfType = LEAVE_ORDER.map((type) =>
            dayEntries.find((entry) => entry.type === type),
          ).filter(Boolean) as LeaveEntry[];
          const primaryType = firstOfType[0]?.type ?? "";
          const primaryTint = DAY_TINT[primaryType] ?? "";

          return (
            <div
              class:list={[
                "cal-day",
                {
                  "cal-day--out": !inMonth,
                  "cal-day--today": dateStr === ctx.todayIso,
                  "cal-day--holiday": isHoliday,
                  "cal-day--weekend": isWeekend,
                  "cal-day--clickable": canAdd,
                  [`cal-day--${primaryTint}`]: Boolean(primaryTint),
                },
              ]}
              data-date={dateStr}
              data-add-entry={canAdd ? "" : undefined}
            >
              <span class="cal-day-num">{day.getDate()}</span>
              {isHoliday && (
                <span class="cal-holiday-label" title={holidays[dateStr]}>
                  {holidays[dateStr]}
                </span>
              )}

              <div class="cal-chips">
                {firstOfType.map((entry) => (
                  <CalendarLeaveChip entry={entry} />
                ))}
                {otDay.map((ot) => (
                  <form
                    method="post"
                    action={actions.deleteOvertime}
                    class="chip-form"
                    data-confirm={`Usunąć wpis nadgodzin z dnia ${dateStr}?`}
                  >
                    <input type="hidden" name="id" value={ot.id} />
                    <button
                      type="submit"
                      class={`cal-chip cal-chip--${ot.type === "earned" ? "ot-earned" : "ot-taken"}`}
                      title={
                        ot.type === "earned"
                          ? `${fmtHours(ot.hours)} godz. nadgodzin — kliknij, aby usunąć`
                          : `${fmtHours(ot.hours)} godz. odebranych — kliknij, aby usunąć`
                      }
                    >
                      <Icon name={ot.type === "earned" ? "more_time" : "schedule"} size={10} />
                      {ot.type === "earned" ? `+${fmtHours(ot.hours)}h` : `-${fmtHours(ot.hours)}h`}
                    </button>
                  </form>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>

    <div class="cal-legend">
      <div class="legend-block">
        <span class="legend-title">Rodzaje wpisów</span>
        <ul class="legend-grid">
          {
            legendTypes.map((item) => (
              <li class="legend-item">
                <span class:list={["legend-swatch", `cal-chip--${item.cls}`]}>
                  <Icon name={item.icon} size={13} />
                </span>
                <span>{item.label}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="legend-block legend-block--markers">
        <span class="legend-title">Oznaczenia dni</span>
        <ul class="legend-grid">
          <li class="legend-item">
            <span class="legend-swatch legend-swatch--today"></span>
            <span>Dzisiaj</span>
          </li>
          <li class="legend-item">
            <span class="legend-swatch legend-swatch--holiday"><Icon name="event" size={13} /></span>
            <span>Święto / dzień wolny</span>
          </li>
        </ul>
      </div>

      <p class="legend-hint">
        <Icon name="info" size={14} />
        <span>Dotknij wolny dzień, aby dodać wpis · dotknij istniejący, aby go usunąć</span>
      </p>
    </div>
  </div>
</BaseLayout>
