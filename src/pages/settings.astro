---
import { actions } from "astro:actions";
import { env } from "cloudflare:workers";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Field from "@/components/Field.astro";
import Icon from "@/components/Icon.astro";
import { getOrCreateConfig } from "@/lib/db";
import { fmtDays, parseYear, yearContext } from "@/lib/dates";

const year = parseYear(Astro.url.searchParams.get("year"));
const ctx = yearContext(year);

const result = Astro.getActionResult(actions.saveSettings);
if (result && !result.error) {
  return Astro.redirect(`/settings?year=${result.data.year}&saved=1`, 303);
}
const saved = Astro.url.searchParams.has("saved");
const error = result?.error?.message || "";

const config = await getOrCreateConfig(env.DB, year);
const carriedOver = Number(config.vacation_carried_over);
const vacTotal = Number(config.vacation_limit) + carriedOver;
---

<BaseLayout
  title={`Ustawienia – ${year}`}
  pageTitle={`Ustawienia ${year}`}
  active="settings"
  year={year}
  yearOptions={ctx.yearOptions}
  today={ctx.today}
>
  <div class="settings-shell">
    <div class="card">
      <div class="card-title">Limity dni</div>

      {saved && <div class="alert alert--success">Zapisano ustawienia.</div>}
      {error && <div class="alert alert--error">{error}</div>}

      <form method="post" action={actions.saveSettings} class="settings-form">
        <input type="hidden" name="year" value={year} />
        <Field
          label="Limit urlopu (dni)"
          type="number"
          id="vacation_limit"
          name="vacation_limit"
          value={Math.trunc(Number(config.vacation_limit))}
          min="0"
          max="100"
          step="1"
          hint="Ustawowy limit na rok (zwykle 26 dni)"
        />

        <Field
          type="number"
          id="vacation_carried_over"
          name="vacation_carried_over"
          value={Math.trunc(carriedOver)}
          min="0"
          max="50"
          step="1"
          hint="Ustaw ręcznie niewykorzystane dni z poprzedniego roku"
        >
          <Fragment slot="label">
            <Icon name="move_down" size={16} />
            Dni przeniesione z {year - 1}
          </Fragment>
        </Field>

        {
          carriedOver > 0 && (
            <div class="info-box">
              <Icon name="info" size={16} />
              Łączna pula urlopu: <strong>{fmtDays(vacTotal)}</strong>(
              {fmtDays(Number(config.vacation_limit))} + {fmtDays(carriedOver)} przeniesione)
            </div>
          )
        }

        <Field
          label="Limit Home Office (dni)"
          type="number"
          id="ho_limit"
          name="ho_limit"
          value={Math.trunc(Number(config.ho_limit))}
          min="0"
          max="260"
          step="1"
          hint="HO nie przechodzi na kolejny rok"
        />

        <button type="submit" class="btn btn-filled settings-submit">
          <Icon name="save" size={18} />
          Zapisz ustawienia
        </button>
      </form>
    </div>
  </div>
</BaseLayout>
