---
import "@/styles/style.css";
// ?url daje plikowi nazwę z hashem treści, więc przeglądarka nie poda starej
// wersji z cache po wdrożeniu zmian.
import appUrl from "@/scripts/app.js?url";
import Field from "@/components/Field.astro";
import Icon from "@/components/Icon.astro";

interface Props {
  title: string;
  pageTitle: string;
  active: "dashboard" | "calendar" | "history" | "settings";
  year: number;
  yearOptions: number[];
  today: Date;
}

const { title, pageTitle, active, year, yearOptions, today } = Astro.props;
const nav = [
  ["dashboard", "dashboard", "Pulpit", `/?year=${year}`],
  [
    "calendar",
    "calendar_month",
    "Kalendarz",
    `/calendar?year=${year}&month=${today.getMonth() + 1}`,
  ],
  ["history", "history", "Historia", `/history?year=${year}`],
  ["settings", "settings", "Ustawienia", `/settings?year=${year}`],
] as const;

const ENTRY_TYPES = [
  ["vacation", "beach_access", "Urlop"],
  ["home_office", "home", "Home Office"],
  ["okolicznosciowy", "celebration", "Okolicznościowy"],
  ["bezplatny", "money_off", "Bezpłatny"],
  ["l4", "medical_services", "L4"],
  ["za_swieto", "event_repeat", "Za święto"],
] as const;

const OKOL_REASONS = [
  "Ślub własny (2 dni)",
  "Ślub dziecka (1 dzień)",
  "Urodzenie dziecka (2 dni)",
  "Zgon i pogrzeb małżonka/dziecka/rodzica (2 dni)",
  "Zgon i pogrzeb brata/siostry/teścia (1 dzień)",
  "Zgon i pogrzeb babci/dziadka (1 dzień)",
  "Inne",
];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/static/images/favicon.svg" />
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#141218" />
  </head>
  <body>
    <div class="layout">
      <nav class="sidebar">
        <div class="sidebar-brand">
          <img
            src="/static/images/logo.svg"
            alt="VanillaDays"
            class="brand-logo"
            width="32"
            height="32"
          />
          <span class="brand-text">VanillaDays</span>
        </div>

        <ul class="nav-list">
          {
            nav.map(([id, icon, label, href]) => (
              <li>
                <a href={href} class:list={["nav-item", { active: active === id }]}>
                  <Icon name={icon} />
                  <span>{label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <header class="topbar">
        <h1 class="page-title">{pageTitle}</h1>
        <div class="topbar-end">
          <select class="year-select" data-year-select aria-label="Wybierz rok">
            {
              yearOptions.map((y) => (
                <option value={y} selected={y === year}>
                  {y}
                </option>
              ))
            }
          </select>
          <form method="post" action="/logout" class="logout-form">
            <button type="submit" class="icon-btn" title="Wyloguj się">
              <Icon name="logout" />
            </button>
          </form>
        </div>
      </header>

      <main class="main-content">
        <slot />
      </main>

      <nav class="bottom-nav">
        {
          nav.map(([id, icon, label, href]) => (
            <a href={href} class:list={["bottom-nav-item", { active: active === id }]}>
              <Icon name={icon} />
              <span>{label}</span>
            </a>
          ))
        }
      </nav>

      <div class="modal-backdrop" data-entry-modal hidden>
        <div class="modal" data-entry-modal-panel role="dialog" aria-modal="true">
          <div class="modal-header">
            <h2 data-entry-modal-title>Dodaj wpis</h2>
            <button class="icon-btn" data-close-entry-modal type="button" aria-label="Zamknij">
              <Icon name="close" />
            </button>
          </div>

          <form action="/entries/save" method="post" data-entry-form>
            <input type="hidden" name="id" data-entry-id />

            <div class="toggle-group toggle-group--6">
              {
                ENTRY_TYPES.map(([type, icon, label], index) => (
                  <button
                    type="button"
                    class:list={["toggle-btn", { active: index === 0 }]}
                    data-entry-type-button
                    data-entry-type={type}
                  >
                    <Icon name={icon} /> {label}
                  </button>
                ))
              }
            </div>
            <input type="hidden" name="type" value="vacation" data-entry-type-input />

            <Field
              label="Data"
              type="date"
              id="entry-date"
              name="date"
              data-entry-date=""
              required
            />

            <Field
              label="Powód urlopu okolicznościowego"
              id="entry-okol"
              wrapperAttrs={{ "data-entry-extra": "okolicznosciowy", hidden: true }}
            >
              <select name="okol_reason" id="entry-okol" class="field-input">
                <option value="">— wybierz powód (opcjonalnie) —</option>
                {OKOL_REASONS.map((reason) => <option value={reason}>{reason}</option>)}
              </select>
            </Field>

            <Field
              label="Numer serii ZUS"
              optional
              type="text"
              id="entry-l4"
              name="l4_number"
              placeholder="np. ZLA/2025/XXXXX"
              wrapperAttrs={{ "data-entry-extra": "l4", hidden: true }}
            />

            <Field
              label="Za które święto"
              optional
              type="text"
              id="entry-za"
              name="za_swieto_day"
              placeholder="np. Boże Narodzenie 25.12"
              wrapperAttrs={{ "data-entry-extra": "za_swieto", hidden: true }}
            />

            <Field label="Notatka" optional id="entry-notes">
              <textarea
                name="notes"
                id="entry-notes"
                class="field-input"
                rows="2"
                maxlength="500"
                data-entry-notes></textarea>
            </Field>

            <div class="form-error" data-entry-form-error hidden></div>

            <div class="modal-actions">
              <button type="button" class="btn btn-text" data-close-entry-modal>Anuluj</button>
              <button type="submit" class="btn btn-filled" data-entry-submit>
                <span class="btn-spinner" data-entry-spinner hidden></span>
                <span data-entry-submit-label>Dodaj</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script src={appUrl} defer is:inline></script>
  </body>
</html>
