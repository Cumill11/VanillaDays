---
import { actions } from "astro:actions";
import Icon from "@/components/Icon.astro";
import { getLeaveTypeMeta } from "@/lib/leaveTypes";
import type { LeaveEntry } from "@/lib/types";

interface Props {
  entry: LeaveEntry;
}

const { entry } = Astro.props;
const date = entry.date.substring(0, 10);
const meta = getLeaveTypeMeta(entry.type);
---

<form
  method="post"
  action={actions.deleteEntry}
  class="chip-form"
  data-confirm={`Usunąć wpis z dnia ${date}?`}
>
  <input type="hidden" name="id" value={entry.id} />
  <button
    type="submit"
    class:list={["cal-chip", meta.calendarClass]}
    title={`${meta.label} — kliknij, aby usunąć`}
  >
    <Icon name={meta.icon} size={10} />{meta.calendarLabel}
  </button>
</form>
