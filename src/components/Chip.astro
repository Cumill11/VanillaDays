---
import Icon from "@/components/Icon.astro";

interface Props {
  class?: string;
  icon?: string;
  iconSize?: number;
}

const { class: className = "", icon, iconSize = 13 } = Astro.props;
---

<span class:list={["chip", className]}>
  {icon && <Icon name={icon} size={iconSize} />}
  <slot />
</span>
