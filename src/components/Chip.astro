---
import Icon from './Icon.astro';

interface Props {
  class?: string;
  icon?: string;
  iconSize?: string;
  title?: string;
}

const { class: className = '', icon, iconSize = '0.8rem', title } = Astro.props;
---
<span class:list={['chip', className]} title={title}>
  {icon && <Icon name={icon} size={iconSize} />}
  <slot />
</span>
