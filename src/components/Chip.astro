---
import Icon from "@/components/Icon.astro";

interface Props {
  class?: string;
  icon?: string;
  iconSize?: number;
  title?: string;
}

const { class: className = "", icon, iconSize = 13, title } = Astro.props;
---

<span class:list={["chip", className]} title={title}>
  {icon && <Icon name={icon} size={iconSize} />}
  <slot />
</span>
