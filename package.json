{
  "name": "vanilladays",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply vanilladays --local",
    "db:migrate:remote": "wrangler d1 migrations apply vanilladays --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.3",
    "@lucide/astro": "^1.25.0",
    "astro": "^7.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260719.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.112.0"
  }
}
