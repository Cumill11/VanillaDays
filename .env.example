DB_HOST=
DB_USER=urlopy
DB_PASSWORD=
DB_NAME=urlopy

# Wygeneruj: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Wygeneruj hash: python3 -c "import bcrypt; print(bcrypt.hashpw(b'TWOJE_HASLO', bcrypt.gensalt(12)).decode())"
LOGIN_USERNAME=
LOGIN_PASSWORD_HASH=

# Ustaw na 1 jeśli aplikacja działa za HTTPS (nginx z SSL)
COOKIE_SECURE=1

# Ustaw na 1 jeśli aplikacja stoi za reverse proxy (nginx/Traefik) - włącza obsługę X-Forwarded-For
TRUSTED_PROXY=1
