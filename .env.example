# ── Baza danych (MySQL / MariaDB) ──
DB_HOST=10.0.1.2
DB_USER=urlopy
DB_PASSWORD=
DB_NAME=urlopy

# Klucz sesji Flask. Wygeneruj:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Dane logowania. Wygeneruj hash hasła:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'TWOJE_HASLO', bcrypt.gensalt(12)).decode())"
# WAŻNE: hash trzymaj w apostrofach — inaczej docker compose interpoluje znak $ i psuje hash.
LOGIN_USERNAME=admin
LOGIN_PASSWORD_HASH=''

# Ustaw na true jeśli aplikacja działa za HTTPS (nginx z SSL) - cookie sesji tylko po HTTPS
HTTPS_ONLY=false

# Ustaw na true jeśli aplikacja stoi za reverse proxy (nginx/Traefik) - włącza obsługę X-Forwarded-For
TRUSTED_PROXY=false

# ── Uruchamianie (python app.py) ──
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
